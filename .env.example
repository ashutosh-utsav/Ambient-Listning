# ─────────────────────────────────────────────
# psychdesk ambient listening — environment config
# Copy to .env and fill in your values.
# ─────────────────────────────────────────────

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# ── AWS credentials ──────────────────────────
# For local dev: use MinIO credentials below.
# For prod: use real AWS IAM credentials.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# ── S3 ───────────────────────────────────────
S3_BUCKET_NAME=recordings
# MinIO endpoint for local dev. Remove (or leave blank) for real AWS S3.
S3_ENDPOINT_URL=http://minio:9000

# ── DynamoDB ─────────────────────────────────
DYNAMODB_TABLE_NAME=sessionIndex
# DynamoDB Local endpoint for local dev. Remove for real AWS DynamoDB.
DYNAMODB_ENDPOINT_URL=http://dynamodb-local:8000

# ── Redis / ARQ ──────────────────────────────
REDIS_URL=redis://redis:6379

# ── Auth (optional API key) ──────────────────
# Set ENABLE_API_KEY_AUTH=true to require a key on all requests.
# HTTP: X-API-Key header. WebSocket: {"type":"AUTH","api_key":"<key>"}
# Leave false for internal microservice use behind a main app gateway.
ENABLE_API_KEY_AUTH=false
API_KEY=

# ── Worker / misc ────────────────────────────
ENVIRONMENT=development
WEBSERVER_ERROR_CALLBACK=http://localhost:8000/ws/error
WORKER_MEMORY_DEBUG=false
ENABLE_VAD=false

# ─────────────────────────────────────────────
# OLD Azure settings (no longer used)
# ─────────────────────────────────────────────
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;...
# AZURE_QUEUE_NAME=transcription-queue
# AZURE_DEAD_LETTER_QUEUE_NAME=failed-tasks-queue
# AZURE_BLOB_CONTAINER_NAME=recordings
# AZURE_TABLE_NAME=sessionIndex
# JWT_SECRET_KEY=your-jwt-secret
# JWT_ALGORITHM=RS256
# JWT_ISSUER=https://login.microsoftonline.com/...
